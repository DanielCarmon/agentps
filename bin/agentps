#!/usr/bin/env bash
#
# agentps — see, and live-watch, every shell command your AI coding agent runs.
# Works with Claude Code, Codex, and OpenCode. Home: https://github.com/DanielCarmon/agentps
#
# Copyright (C) 2026 Daniel Carmon.  Vibecoded by Daniel Carmon and Claude Opus 4.8.
# GNU General Public License v3.0 or later — see LICENSE / <https://www.gnu.org/licenses/>.
#
# agentps — the viewer half: shows the processes your AI coding agent runs.
# Reads per-command logs under ~/.local/share/agentps/runlogs (written by the capture adapters for
# Claude Code / Codex / OpenCode) and renders them live.
# Part of https://github.com/DanielCarmon/agentps.
#
# Interactive TUI (the `agentps` command):
#   ↑/↓ (or j/k)  select a process     ←/→ (or h/l)  change its view mode (tail/vim/pager)
#   Enter         open it              Tab           focus the "go to #" field
#   a=all sessions   n=newest-only     q/Esc=quit
# Each task remembers its last view mode (persisted in ~/.local/share/agentps/runlogs/.viewmodes/.defaultmode).
# Subcommands: agentps watch (dashboard) · last (tail newest) · list (one-shot) · clean [days].

export RUNLOG_DIR="${RUNLOG_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/agentps/runlogs}"
_APS_SELF="${BASH_SOURCE[0]:-$0}"   # this file's own path, so subshells can re-source it

# ---------- shared data helpers ----------

function _aps_logs {
    local scope="${1:-}"
    if [ "$scope" = "all" ]; then
        find "$RUNLOG_DIR" -maxdepth 2 -type f -name '*.log' 2>/dev/null
    elif [ -n "$scope" ] && [ -d "$RUNLOG_DIR/$scope" ]; then
        find "$RUNLOG_DIR/$scope" -maxdepth 1 -type f -name '*.log' 2>/dev/null
    else
        local newest sdir
        newest="$(find "$RUNLOG_DIR" -maxdepth 2 -type f -name '*.log' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"
        [ -z "$newest" ] && return 0
        sdir="$(dirname "$newest")"
        find "$sdir" -maxdepth 1 -type f -name '*.log' 2>/dev/null
    fi
}

# one find call -> "basename \t mtime \t size \t path", scope-aware
function _aps_find_lines {
    local scope="${1:-}"
    if [ "$scope" = "all" ]; then
        find "$RUNLOG_DIR" -maxdepth 2 -type f -name '*.log' -printf '%f\t%T@\t%s\t%p\n' 2>/dev/null
    elif [ -n "$scope" ] && [ -d "$RUNLOG_DIR/$scope" ]; then
        find "$RUNLOG_DIR/$scope" -maxdepth 1 -type f -name '*.log' -printf '%f\t%T@\t%s\t%p\n' 2>/dev/null
    else
        local newest sdir
        newest="$(find "$RUNLOG_DIR" -maxdepth 2 -type f -name '*.log' -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -1 | cut -f2-)"
        [ -z "$newest" ] && return 0
        sdir="${newest%/*}"
        find "$sdir" -maxdepth 1 -type f -name '*.log' -printf '%f\t%T@\t%s\t%p\n' 2>/dev/null
    fi
}

function _aps_start_epoch {
    local b stamp rest hms
    b="$(basename "$1")"
    stamp="${b%%_*}"; rest="${b#*_}"; hms="${rest%%_*}"
    if [[ "$stamp" =~ ^[0-9]{8}$ && "$hms" =~ ^[0-9]{6}$ ]]; then
        date -d "${stamp:0:4}-${stamp:4:2}-${stamp:6:2} ${hms:0:2}:${hms:2:2}:${hms:4:2}" +%s 2>/dev/null && return
    fi
    stat -c %Y "$1" 2>/dev/null
}

function _aps_status {
    local code pid bp
    # alive if the wrapper pid OR any detached bg-job pid is still running (bg pids sit near the end)
    pid="$(grep -m1 '^### pid: ' "$1" 2>/dev/null | sed 's/^### pid: //')"
    { [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; } && { echo "RUN|-"; return; }
    for bp in $(tail -n 8 "$1" 2>/dev/null | sed -n 's/^### bgpid: //p'); do
        kill -0 "$bp" 2>/dev/null && { echo "RUN|-"; return; }
    done
    code="$(grep -m1 '^### \[exit' "$1" 2>/dev/null | sed -E 's/.*\[exit ([0-9]+)\].*/\1/')"
    [ -n "$code" ] && echo "DONE|$code" || echo "STALL|-"
}

function _aps_fmt_dur {
    local s="$1"
    if   [ "$s" -lt 60 ];   then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ]; then printf '%dm%02ds' "$((s/60))" "$((s%60))"
    else printf '%dh%02dm' "$((s/3600))" "$(((s%3600)/60))"; fi
}

# ---------- one-shot table (procs / procwatch) — simple, not perf-critical ----------
function _aps_collect { local scope="$1" f; _APS_FILES=(); while IFS= read -r f; do [ -z "$f" ] && continue; _APS_FILES+=("$f"); done < <(_aps_logs "$scope" | while IFS= read -r f; do printf '%s\t%s\n' "$(_aps_start_epoch "$f")" "$f"; done | sort -rn | cut -f2-); }
function _aps_fields {
    local f="$1" now st code se me start dur endref bplain bcolor desc cmd
    now="$(date +%s)"; se="$(_aps_start_epoch "$f")"; me="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"
    IFS='|' read -r st code < <(_aps_status "$f")
    start="$(date -d "@$se" '+%H:%M:%S' 2>/dev/null)"
    [ "$st" = "DONE" ] && endref="$me" || endref="$now"
    dur="$(_aps_fmt_dur "$(( endref - se ))")"
    if   [ "$st" = "RUN" ];   then bplain="● running"; bcolor=$'\033[1;32m'
    elif [ "$st" = "STALL" ]; then bplain="● stalled"; bcolor=$'\033[33m'
    elif [ "$code" = "0" ];   then bplain="✔ exit 0";  bcolor=$'\033[32m'
    else bplain="✗ exit $code"; bcolor=$'\033[1;31m'; fi
    desc="$(grep -m1 '^### desc:' "$f" 2>/dev/null | sed 's/^### desc: //' | tr '\n\t' '  ')"; desc="${desc:--}"; desc="${desc:0:34}"
    cmd="$(grep -m1 '^### cmd :' "$f" 2>/dev/null | sed 's/^### cmd : //' | tr '\n\t' '  ')"; cmd="${cmd:0:70}"
    printf '%s\t%s\t%s\t%s\t%s\t%s' "$start" "$dur" "$bplain" "$bcolor" "$desc" "$cmd"
}
function _aps_table {
    local scope="${1:-}" f i=0 start dur bplain bcolor desc cmd now="$(date +%s)" minstart="" maxact=0 running=0 st code se me
    _aps_collect "$scope"
    for f in "${_APS_FILES[@]}"; do se="$(_aps_start_epoch "$f")"; me="$(stat -c %Y "$f" 2>/dev/null||echo "$now")"; [ -z "$minstart" ]&&minstart="$se"; [ "$se" -lt "$minstart" ] 2>/dev/null&&minstart="$se"; [ "$me" -gt "$maxact" ] 2>/dev/null&&maxact="$me"; IFS='|' read -r st code < <(_aps_status "$f"); [ "$st" = RUN ]&&running=$((running+1)); done
    local lbl; if [ "$scope" = all ]; then lbl="ALL sessions"; elif ((${#_APS_FILES[@]})); then lbl="$(basename "$(dirname "${_APS_FILES[0]}")")"; else lbl="(none)"; fi
    printf '\033[1;36m▶ agentps\033[0m  \033[1m%s\033[0m\n\033[2m  dir: %s\033[0m\n' "$lbl" "$RUNLOG_DIR"
    ((${#_APS_FILES[@]})) && printf '\033[2m  started: %s    last activity: %s\033[0m\n' "$(date -d "@$minstart" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)" "$(date -d "@$maxact" '+%H:%M:%S' 2>/dev/null)"
    printf '  processes: \033[1m%d\033[0m   running: \033[1;32m%d\033[0m\n' "${#_APS_FILES[@]}" "$running"
    printf '\n\033[1m  #  START     DUR      STATUS       DESC                                COMMAND\033[0m\n  ──────────────────────────────────────────────────────────────────────────────────────────────\n'
    ((${#_APS_FILES[@]}==0)) && { printf '  (no agent-spawned processes captured)\n'; return; }
    for f in "${_APS_FILES[@]}"; do i=$((i+1)); IFS=$'\t' read -r start dur bplain bcolor desc cmd < <(_aps_fields "$f"); printf '  %2d  %-8s  %7s  %s%-13s\033[0m  %-34s  %s\n' "$i" "$start" "$dur" "$bcolor" "$bplain" "$desc" "$cmd"; done
}

# ---------- followers ----------
function _aps_tail {
    local f="$1" key tpid
    printf '\033[2J\033[H\033[1;32m● live tail\033[0m  %s\n\033[2m  (Esc or q = back)\033[0m\n\n' "$f"
    tail -n 300 -F "$f" & tpid=$!
    while IFS= read -rsn1 key; do if [ "$key" = $'\e' ] || [ "$key" = q ] || [ "$key" = Q ]; then break; fi; done
    kill "$tpid" 2>/dev/null; wait "$tpid" 2>/dev/null; return 0
}
function _aps_mode_cycle { local order=(t v c m) i; case "$1" in v) i=1;; c) i=2;; m) i=3;; *) i=0;; esac; [ "$2" = 1 ] && i=$(((i+1)%4)) || i=$(((i+3)%4)); echo "${order[i]}"; }
# show the full (un-flattened) command + its context, pager-style
function _aps_showcmd {
    { printf '\033[1mcommand\033[0m\n\n'; grep -m1 '^### cmd : ' "$1" 2>/dev/null | sed 's/^### cmd : //; s/ ↵ /\n/g'
      printf '\n\033[2m'; grep -m1 '^### desc:'  "$1" 2>/dev/null | sed 's/^### /  /'
      grep -m1 '^### cwd :'   "$1" 2>/dev/null | sed 's/^### /  /'
      grep -m1 '^### agent:'  "$1" 2>/dev/null | sed 's/^### /  /'; printf '\033[0m'
    } | less -R
}
function _aps_run {
    case "$2" in
        v) printf '\033[?25h'; vim "$1";           stty -echo -icanon min 1 time 0 2>/dev/null; printf '\033[?25l' ;;
        c) printf '\033[?25h'; less "$1";          stty -echo -icanon min 1 time 0 2>/dev/null; printf '\033[?25l' ;;
        m) printf '\033[?25h'; _aps_showcmd "$1";  stty -echo -icanon min 1 time 0 2>/dev/null; printf '\033[?25l' ;;
        *) _aps_tail "$1" ;;
    esac
}

# ---------- fast cached refresh for the interactive viewer (dynamic-scope into the viewer) ----------
# steady state: 1 find + 1 sort + 1 tail-per-running-file. epoch/command cached forever per file.
function _aps_refresh2 {
    local base mt sz path cl code now ep endref ds bp bc szh i minstart="" maxact=0 running=0 start
    F=(); MT=(); SZ=()
    while IFS=$'\t' read -r base mt sz path; do
        [ -z "$path" ] && continue
        F+=("$path"); MT+=("${mt%.*}"); SZ+=("$sz")
    done < <(_aps_find_lines "$scope" | sort -r)
    # one ps snapshot -> pid/ppid/rss/cpu maps for live per-process resource stats
    PS_RSS=(); PS_CPU=(); PS_CH=()
    if ((${#F[@]})); then
        local _pid _ppid _rss _cpu
        while read -r _pid _ppid _rss _cpu; do
            [ -z "$_pid" ] && continue
            PS_RSS["$_pid"]="$_rss"; PS_CPU["$_pid"]="$_cpu"; PS_CH["$_ppid"]+="$_pid "
        done < <(ps -eo pid=,ppid=,rss=,pcpu= 2>/dev/null)
    fi
    # map logpath -> live descendant pids via the AGENTPS_JOB env marker (survives detach; catches
    # foreground children, backgrounded jobs, and fully-detached daemons alike). One grep to scan.
    JOBPIDS=()
    if ((${#F[@]})); then
        local _envf _jp _jid
        while IFS= read -r _envf; do
            _jp="${_envf#/proc/}"; _jp="${_jp%/environ}"
            _jid="$( { tr '\0' '\n' < "$_envf"; } 2>/dev/null | sed -n 's/^AGENTPS_JOB=//p' | head -1)"
            [ -n "$_jid" ] && JOBPIDS["$_jid"]+="$_jp "
        done < <(grep -zla 'AGENTPS_JOB=' /proc/[0-9]*/environ 2>/dev/null)
    fi
    printf -v now '%(%s)T' -1
    CS=(); CD=(); CBP=(); CBC=(); CSZ=(); CCMD=()
    for ((i=0; i<${#F[@]}; i++)); do
        path="${F[i]}"
        [ -z "${EPC[$path]+x}" ] && EPC["$path"]="$(_aps_start_epoch "$path")"      # date fork ONCE per file
        ep="${EPC[$path]}"; [ -z "$ep" ] && ep="${MT[i]}"
        # scan header by PREFIX (robust to multi-line commands), NO fork; retry pid while running
        if [ -z "${CMDC[$path]+x}" ] || { [ -z "${PIDC[$path]:-}" ] && [ -z "${DONEC[$path]+x}" ]; }; then
            local ln lc="" ld="" lt="" lp="" cnt=0
            while IFS= read -r ln; do
                (( ++cnt > 30 )) && break
                case "$ln" in
                    '### cmd : '*)  [ -z "$lc" ] && lc="${ln#'### cmd : '}" ;;
                    '### desc: '*)  ld="${ln#'### desc: '}" ;;
                    '### tmux: '*)  lt="${ln#'### tmux: '}" ;;
                    '### pid: '*)   lp="${ln#'### pid: '}" ;;
                esac
            done < "$path" 2>/dev/null
            [ -z "${CMDC[$path]+x}" ] && { lc="${lc//$'\t'/ }"; CMDC["$path"]="${lc:0:200}"; }   # keep full-ish; truncated at draw to fit width
            [ -z "${DESCC[$path]+x}" ] && DESCC["$path"]="${ld:0:120}"
            [ -z "${TMUXC[$path]+x}" ] && TMUXC["$path"]="${lt:--}"
            [ -n "$lp" ] && PIDC["$path"]="$lp"
        fi
        if [ -z "${DONEC[$path]+x}" ]; then                                        # tail: grab exit footer + detached bg pids
            local t8 foot bgl bgs=""
            t8="$(tail -n 8 "$path" 2>/dev/null)"
            case "$t8" in *'### [exit '*)
                foot="${t8##*'### [exit '}"; foot="${foot%%$'\n'*}"                 # "N] HH:MM:SS"
                DONEC["$path"]="${foot%%]*}"; ENDC["$path"]="${foot##* }"
                while IFS= read -r bgl; do case "$bgl" in '### bgpid: '*) bgs+="${bgl#'### bgpid: '} ";; esac; done <<< "$t8"
                BGPIDC["$path"]="$bgs" ;;
            esac
        fi
        [ -z "$minstart" ] && minstart="$ep"; (( ep < minstart )) && minstart="$ep"
        (( MT[i] > maxact )) && maxact="${MT[i]}"
        local alive=0 ram="-" cpud="-" endd live_root="" bgp
        local __jpids="${JOBPIDS[$path]:-}"
        if [ -n "$__jpids" ]; then                                          # env-marker: exact live descendants
            alive=1
            local __jr=0 __jc=0 __jp __c
            for __jp in $__jpids; do __jr=$(( __jr + ${PS_RSS[$__jp]:-0} )); __c="${PS_CPU[$__jp]:-0}"; __jc=$(( __jc + ${__c%%.*} )); done
            ram="$(( __jr / 1024 ))M"; cpud="${__jc}%"
        else                                                               # fallback for logs without the marker
            for bgp in ${BGPIDC[$path]:-}; do [ -n "${PS_RSS[$bgp]+x}" ] && { live_root="$bgp"; alive=1; break; }; done
            if (( ! alive )) && [ -z "${DONEC[$path]+x}" ]; then
                if   [ -n "${PIDC[$path]:-}" ] && [ -n "${PS_RSS[${PIDC[$path]}]+x}" ]; then live_root="${PIDC[$path]}"; alive=1
                elif [ -z "${PIDC[$path]:-}" ] && (( now - MT[i] <= 15 )); then alive=1; fi
            fi
            (( alive )) && [ -n "$live_root" ] && { _aps_subtree "$live_root"; ram="$(( SUB_RSS / 1024 ))M"; cpud="${SUB_CPU}%"; }
        fi
        if (( alive )); then
            running=$((running+1)); bp="● running"; bc=$'\033[1;32m'; endref="$now"; endd="-"
        elif [ -n "${DONEC[$path]+x}" ]; then
            endref="${MT[i]}"; code="${DONEC[$path]}"; endd="${ENDC[$path]:--}"
            if [ "$code" = 0 ]; then bp="✔ exit 0"; bc=$'\033[32m'; else bp="✗ exit $code"; bc=$'\033[1;31m'; fi
        else
            endref="$now"; endd="-"; bp="● stalled"; bc=$'\033[33m'
        fi
        printf -v start '%(%H:%M:%S)T' "$ep"
        ds=$(( endref - ep ))
        if   (( ds < 60 ));   then printf -v CD_i '%ds' "$ds"
        elif (( ds < 3600 )); then printf -v CD_i '%dm%02ds' "$((ds/60))" "$((ds%60))"
        else printf -v CD_i '%dh%02dm' "$((ds/3600))" "$(((ds%3600)/60))"; fi
        sz="${SZ[i]}"
        if   (( sz >= 1048576 )); then szh="$((sz/1048576))M"; elif (( sz >= 1024 )); then szh="$((sz/1024))K"; else szh="${sz}B"; fi
        local dd="${DESCC[$path]:-}"; [ -z "$dd" ] && dd="-"
        CS+=("$start"); CD+=("$CD_i"); CEND+=("$endd"); CBP+=("$bp"); CBC+=("$bc"); CCPU+=("$cpud"); CRAM+=("$ram"); CTMUX+=("${TMUXC[$path]:--}"); CDESC+=("$dd"); CCMD+=("${CMDC[$path]}")
    done
    local lbl dir hs="" ha=""
    if [ "$scope" = all ]; then lbl="ALL sessions"; elif ((${#F[@]})); then dir="${F[0]%/*}"; lbl="${dir##*/}"; else lbl="(none)"; fi
    if ((${#F[@]})); then printf -v hs '%(%Y-%m-%d %H:%M:%S)T' "$minstart"; printf -v ha '%(%H:%M:%S)T' "$maxact"; fi
    printf -v HEADER '\033[1;36m▶ agentps\033[0m  \033[1m%s\033[0m\n\033[2m  dir: %s\033[0m\n\033[2m  started: %s    last activity: %s\033[0m\n  processes: \033[1m%d\033[0m   running: \033[1;32m%d\033[0m' "$lbl" "$RUNLOG_DIR" "$hs" "$ha" "${#F[@]}" "$running"
}

# read terminal size into TROWS/TCOLS (viewer locals, via dynamic scope)
function _aps_size {
    TROWS="$(tput lines 2>/dev/null || echo 40)"; TCOLS="$(tput cols 2>/dev/null || echo 200)"
    [[ "$TROWS" =~ ^[0-9]+$ ]] || TROWS=40; [[ "$TCOLS" =~ ^[0-9]+$ ]] || TCOLS=200
}

# sum RSS(kb) + CPU(%) over the process subtree rooted at $1; sets SUB_RSS / SUB_CPU
function _aps_subtree {
    SUB_RSS=0; SUB_CPU=0
    local stack=("$1") p k c
    while ((${#stack[@]})); do
        p="${stack[-1]}"; unset 'stack[-1]'
        SUB_RSS=$(( SUB_RSS + ${PS_RSS[$p]:-0} ))
        c="${PS_CPU[$p]:-0}"; SUB_CPU=$(( SUB_CPU + ${c%%.*} ))
        for k in ${PS_CH[$p]:-}; do stack+=("$k"); done
    done
}

# clamp the jump buffer to [1,n] and move the selection there
function _aps_clampjump {
    [ -z "$jbuf" ] && return
    jbuf="$((10#$jbuf))"
    (( jbuf < 1 )) && jbuf=1
    (( n > 0 && jbuf > n )) && jbuf=n
    (( n > 0 )) && cur=$((jbuf-1))
}

# change selected task's mode ($1=1 fwd / 0 back); persist last-choice as default
function _aps_setmode {
    (( n == 0 )) && return
    local newm; newm="$(_aps_mode_cycle "${_APS_MODE[${F[cur]}]:-$defmode}" "$1")"
    _APS_MODE["${F[cur]}"]="$newm"
    printf '%s\n' "$newm" > "$RUNLOG_DIR/.defaultmode" 2>/dev/null
}

# ---------- main interactive viewer ----------
function agentps {
    local scope="${1:-all}" cur=0 key seq n _aps_quit=0 selmode focus=list jbuf=""
    local -a F=() MT=() SZ=() CS=() CD=() CBP=() CBC=() CSZ=() CCMD=() CEND=() CRAM=() CCPU=() CTMUX=() CDESC=()
    local -A EPC=() CMDC=() DESCC=() DONEC=() ENDC=() PIDC=() BGPIDC=() TMUXC=() PS_RSS=() PS_CPU=() PS_CH=() JOBPIDS=() _APS_MODE=()
    local SUB_RSS=0 SUB_CPU=0
    local HEADER="" CD_i top=0 TROWS=40 TCOLS=200
    local defmode; defmode="$(cat "$RUNLOG_DIR/.defaultmode" 2>/dev/null)"; case "$defmode" in t|v|c|m) : ;; *) defmode=t ;; esac
    if [ -f "$RUNLOG_DIR/.viewmodes" ]; then local _p _m; while IFS=$'\t' read -r _p _m; do [ -n "$_p" ] && _APS_MODE["$_p"]="$_m"; done < "$RUNLOG_DIR/.viewmodes"; fi
    local dashes; printf -v dashes '%200s' ''; dashes="${dashes// /-}"   # reusable separator buffer
    local saved; saved="$(stty -g 2>/dev/null)"
    stty -echo -icanon min 1 time 0 2>/dev/null
    printf '\033[?1049h\033[?25l'
    _aps_size; trap '_aps_quit=1' INT; trap '_aps_size' WINCH
    _aps_refresh2

    while true; do
        [ "$_aps_quit" = 1 ] && break
        printf '\033[?25l'
        n=${#F[@]}
        (( cur < 0 )) && cur=0
        (( n > 0 && cur >= n )) && cur=$((n-1))

        # ---- paint from cache (fork-free) ----
        local out i row line c
        # size sparse columns (TMUX/CPU/RAM/DESC) to their actual content; COMMAND fills the rest
        local CPUW=3 RAMW=3 TMUXW=4 DESCW=4
        for c in "${CCPU[@]}";  do (( ${#c} > CPUW ))  && CPUW=${#c};  done
        for c in "${CRAM[@]}";  do (( ${#c} > RAMW ))  && RAMW=${#c};  done
        for c in "${CTMUX[@]}"; do (( ${#c} > TMUXW )) && TMUXW=${#c}; done; (( TMUXW > 14 )) && TMUXW=14
        for c in "${CDESC[@]}"; do (( ${#c} > DESCW )) && DESCW=${#c}; done; (( DESCW > 44 )) && DESCW=44
        local cmdw=$(( TCOLS - 66 - TMUXW - CPUW - RAMW - DESCW )); (( cmdw < 12 )) && cmdw=12
        out=$'\033[H'
        while IFS= read -r line; do out+="$line"$'\033[K\n'; done <<< "$HEADER"
        printf -v row '\033[1m  %2s  %-*s  %-8s  %-8s  %6s  %-8s  %-11s  %*s  %*s  %-*s  %s\033[0m' '#' "$TMUXW" TMUX SESSION START DUR END STATUS "$CPUW" CPU "$RAMW" RAM "$DESCW" DESC COMMAND
        out+=$'\033[K\n'"$row"$'\033[K\n'   # blank spacer line MUST clear itself too
        out+="  ${dashes:0:$(( TCOLS>6 ? TCOLS-2 : 120 ))}"$'\033[K\n'
        # viewport: only draw as many rows as fit, scroll window to keep cursor visible
        local listcap=$(( TROWS - 11 )); (( listcap < 3 )) && listcap=3
        (( cur < top )) && top=$cur
        (( cur >= top + listcap )) && top=$(( cur - listcap + 1 ))
        (( n > listcap && top > n - listcap )) && top=$(( n - listcap ))
        (( top < 0 )) && top=0
        (( n == 0 )) && out+=$'  (no agent-spawned processes captured)\033[K\n'
        local sess tm dsc vend=$(( top + listcap )); (( vend > n )) && vend=$n
        for ((i=top; i<vend; i++)); do
            sess="${F[i]%/*}"; sess="${sess##*/}"; sess="${sess:0:8}"
            tm="${CTMUX[i]}"; (( ${#tm} > TMUXW )) && tm="${tm:0:TMUXW}"
            dsc="${CDESC[i]}"; (( ${#dsc} > DESCW )) && dsc="${dsc:0:DESCW}"
            c="${CCMD[i]}"; (( ${#c} > cmdw )) && c="${c:0:cmdw}"
            if (( i == cur )); then
                printf -v row '\033[7m  %2d  %-*s  %-8s  %-8s  %6s  %-8s  %-13s  %*s  %*s  %-*s  %s\033[0m' "$((i+1))" "$TMUXW" "$tm" "$sess" "${CS[i]}" "${CD[i]}" "${CEND[i]}" "${CBP[i]}" "$CPUW" "${CCPU[i]}" "$RAMW" "${CRAM[i]}" "$DESCW" "$dsc" "$c"
            else
                printf -v row '  %2d  %-*s  %-8s  %-8s  %6s  %-8s  %s%-13s\033[0m  %*s  %*s  %-*s  %s' "$((i+1))" "$TMUXW" "$tm" "$sess" "${CS[i]}" "${CD[i]}" "${CEND[i]}" "${CBC[i]}" "${CBP[i]}" "$CPUW" "${CCPU[i]}" "$RAMW" "${CRAM[i]}" "$DESCW" "$dsc" "$c"
            fi
            out+="$row"$'\033[K\n'
        done
        # scroll indicator / spacer (fixed height)
        if (( n > listcap )); then printf -v row '  \033[2m▲▼ %d–%d of %d\033[0m' "$((top+1))" "$vend" "$n"; else row=''; fi
        out+="$row"$'\033[K\n'
        # mode selector footer
        if (( n > 0 )); then selmode="${_APS_MODE[${F[cur]}]:-$defmode}"; else selmode="$defmode"; fi
        out+='  view:  '; local pair m lbl2
        for pair in t:tail-live v:vim c:pager m:cmd; do
            m="${pair%%:*}"; lbl2="${pair#*:}"
            if [ "$m" = "$selmode" ]; then out+=$'\033[7m '"$lbl2"$' \033[0m  '; else out+=$'\033[2m '"$lbl2"$' \033[0m  '; fi
        done
        out+=$'\033[K\n'
        # jump field
        if [ "$focus" = jump ]; then
            printf -v row '  \033[7m go to #: %s_ \033[0m   \033[2m(digits \302\267 \342\206\221\342\206\223 adjust \302\267 Enter jump \302\267 Esc/Tab leave)\033[0m' "$jbuf"
        else
            printf -v row '  \033[2mgo to #: [Tab]      \342\206\221\342\206\223 select \302\267 \342\206\220\342\206\222 mode \302\267 Enter open \302\267 q quit\033[0m'
        fi
        out+="$row"$'\033[K\033[J'
        # coalesce held-key bursts: only repaint when the input buffer is drained,
        # so scrolling stays reactive and stops the instant you release the key.
        IFS= read -rsn1 -t 0 2>/dev/null || printf '%s' "$out"

        # ---- input; refresh ONLY on idle timeout (never blocks a keypress) ----
        IFS= read -rsn1 -t 1 key || { _aps_refresh2; continue; }
        [ "$_aps_quit" = 1 ] && break

        if [ "$focus" = jump ]; then
            case "$key" in
                '' ) focus=list ;;                                   # Enter = confirm jump
                $'\t') focus=list ;;                                 # Tab = leave field
                $'\033') if IFS= read -rsn2 -t 0.05 seq; then case "$seq" in
                             '[A'|'[C') jbuf=$(( ${jbuf:-$((cur+1))} + 1 )); _aps_clampjump ;;
                             '[B'|'[D') jbuf=$(( ${jbuf:-$((cur+1))} - 1 )); _aps_clampjump ;;
                         esac; else focus=list; fi ;;                # bare Esc = leave field
                $'\177'|$'\b') jbuf="${jbuf%?}"; _aps_clampjump ;;
                [0-9]) jbuf="${jbuf}${key}"; _aps_clampjump ;;
            esac
            continue
        fi

        # focus == list
        if [ -z "$key" ]; then                                       # Enter opens
            (( n > 0 )) && { _aps_run "${F[cur]}" "${_APS_MODE[${F[cur]}]:-$defmode}"; printf '\033[2J\033[H'; _aps_refresh2; }
            continue
        fi
        case "$key" in
            $'\t') focus=jump; jbuf="" ;;
            $'\033') if IFS= read -rsn2 -t 0.05 seq; then case "$seq" in
                         '[A') (( cur > 0 ))   && cur=$((cur-1)) ;;
                         '[B') (( cur < n-1 )) && cur=$((cur+1)) ;;
                         '[C') _aps_setmode 1 ;;
                         '[D') _aps_setmode 0 ;;
                     esac; else break; fi ;;                          # bare Esc quits
            k|K) (( cur > 0 ))   && cur=$((cur-1)) ;;
            j|J) (( cur < n-1 )) && cur=$((cur+1)) ;;
            l|L) _aps_setmode 1 ;;
            h|H) _aps_setmode 0 ;;
            q|Q) break ;;
            a|A) scope="all"; cur=0; top=0; _aps_refresh2 ;;
            N|n) scope="";    cur=0; top=0; _aps_refresh2 ;;
            [0-9]) focus=jump; jbuf="$key"; _aps_clampjump ;;          # digit -> jump field (does NOT open)
        esac
    done

    { local _p; for _p in "${!_APS_MODE[@]}"; do printf '%s\t%s\n' "$_p" "${_APS_MODE[$_p]}"; done; } > "$RUNLOG_DIR/.viewmodes" 2>/dev/null
    trap - INT
    stty "$saved" 2>/dev/null
    printf '\033[?25h\033[?1049l'
    return 0
}

# ---------- non-interactive helpers ----------
function procwatch { local scope="${1:-}"; watch -t -c -n 1 "bash -c 'source \"$_APS_SELF\"; _aps_table \"$scope\"'"; }
function procs { _aps_table "${1:-}"; }
function proclast { local f; f="$(_aps_logs all | while IFS= read -r x; do printf '%s\t%s\n' "$(stat -c %Y "$x" 2>/dev/null)" "$x"; done | sort -rn | head -1 | cut -f2-)"; [ -z "$f" ] && { echo "no agent-spawned processes captured"; return 1; }; _aps_tail "$f"; }
function procclean { local days="${1:-7}"; find "$RUNLOG_DIR" -type f -name '*.log' -mtime +"$days" -delete 2>/dev/null; find "$RUNLOG_DIR" -mindepth 1 -type d -empty -delete 2>/dev/null; echo "pruned capture logs older than ${days}d"; }

# ---------- CLI entrypoint (runs only when executed directly, not when sourced) ----------
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
    case "${1:-}" in
        watch)          shift; procwatch "${1:-all}" ;;
        last)           proclast ;;
        list|ls)        shift; procs "${1:-all}" ;;
        clean)          shift; procclean "${1:-}" ;;
        -h|--help|help)
            printf '%s\n' \
              "agentps — view the processes your AI coding agent runs (Claude Code, Codex, OpenCode)" \
              "" "usage:" \
              "  agentps [all|<session>]   interactive TUI (default: ALL sessions/agents)" \
              "  agentps watch [all]       read-only auto-refreshing dashboard" \
              "  agentps last              live-tail the most recent command" \
              "  agentps list [all]        one-shot table (no TUI)" \
              "  agentps clean [days]      prune capture logs older than N days (default 7)" \
              "" "keys:  up/down select . left/right view-mode (tail/vim/pager/cmd) . n=this-session . Enter open . q quit" ;;
        *)              agentps "${1:-}" ;;
    esac
fi
